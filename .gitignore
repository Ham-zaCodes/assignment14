# Root-level ignores
node_modules/
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log

# Environment variables
.env
.env.*
*.env

# Coverage reports
coverage/
*.lcov

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Build outputs
dist/
tmp/
.cache/

# Frontend (React)
frontend/node_modules/
frontend/build/

# Backend (Node)
backend/node_modules/
backend/dist/
backend/tmp/

# Lock files (optional, if you don’t want to commit them)
package-lock.json
yarn.lock
pnpm-lock.yaml
